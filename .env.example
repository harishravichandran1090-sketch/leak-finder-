# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NVIDIA_API_KEY: Optional API key for NVIDIA Nemotron LLM explanations and chat assistant.
# If not provided, LeakFinder AI seamlessly falls back to rigorous rule-based analytics.
NVIDIA_API_KEY=""

# NEMOTRON_MODEL: Model identifier on NVIDIA build API (defaults to nvidia/llama-3.1-nemotron-70b-instruct)
NEMOTRON_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"
